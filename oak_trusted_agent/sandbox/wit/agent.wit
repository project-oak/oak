package oak:agent@0.1.0;

interface tools {
    record tool-description {
        name: string,
        description: string,
        input-schema: string,
    }

    list-tools: func() -> list<tool-description>;
    call-tool: func(name: string, arguments: string) -> result<string, string>;
}

interface agent {
    run: func(user-message: string) -> result<string, string>;
}

world oak-agent {
    import wasi:http/outgoing-handler@0.2.0;
    import wasi:clocks/wall-clock@0.2.0;
    import wasi:random/random@0.2.0;
    import tools;

    export agent;
}
