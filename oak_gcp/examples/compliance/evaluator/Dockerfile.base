# Attested Model Base for Compliance Evaluator
# Bakes Ollama and specified quantized Gemma model at build time.

FROM ollama/ollama:latest

RUN apt-get update && apt-get install -y curl jq ca-certificates && rm -rf /var/lib/apt/lists/*

# Optimize Ollama runtime performance on confidential CPU VMs
ENV OLLAMA_HOST=127.0.0.1:11434
ENV OLLAMA_ORIGINS=*
ENV OLLAMA_NO_MMAP=1
ENV OLLAMA_KEEP_ALIVE=-1
ENV OLLAMA_NUM_PARALLEL=1
ENV OLLAMA_KV_CACHE_TYPE=q4_0
ENV OLLAMA_FLASH_ATTENTION=1
ENV LLAMA_ARG_SWA_FULL=true

# Customizable Model Build Argument (defaults to gemma4:e4b)
ARG MODEL=gemma4:e4b
ENV OLLAMA_MODEL=${MODEL}

# Bake model into container layer
RUN nohup bash -c "ollama serve &" && sleep 10 && ollama pull ${MODEL}
